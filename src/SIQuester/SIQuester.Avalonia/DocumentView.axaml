<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIQuester.ViewModel"
             x:Class="SIQuester.Avalonia.DocumentView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="#3A3A37">
      <WrapPanel x:Name="Toolbar" />
    </Border>
    <Grid ColumnDefinitions="380,5,*">
      <TreeView x:Name="Tree" ItemsSource="{Binding Packages}" SelectionChanged="Tree_SelectionChanged">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:PackageViewModel" ItemsSource="{Binding Rounds}">
            <TextBlock Text="{Binding Model.Name}" FontWeight="Bold">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="＋ Раунд" Command="{Binding AddRound}" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
          </TreeDataTemplate>
          <TreeDataTemplate DataType="vm:RoundViewModel" ItemsSource="{Binding Themes}">
            <TextBlock Text="{Binding Model.Name}" FontWeight="SemiBold">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="＋ Тема" Command="{Binding AddTheme}" />
                  <MenuItem Header="⧉ Клонировать" Command="{Binding Clone}" />
                  <MenuItem Header="🗑 Удалить" Command="{Binding Remove}" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
          </TreeDataTemplate>
          <TreeDataTemplate DataType="vm:ThemeViewModel" ItemsSource="{Binding Questions}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Model.Name}" VerticalAlignment="Center" />
              <Button Content="+" Padding="7,0" MinHeight="22" Command="{Binding AddQuestion}" ToolTip.Tip="Добавить вопрос" />
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="＋ Вопрос" Command="{Binding AddQuestion}" />
                  <MenuItem Header="＋ Пустой вопрос" Command="{Binding AddEmptyQuestion}" />
                  <MenuItem Header="↕ Сортировать" Command="{Binding SortQuestions}" />
                  <MenuItem Header="🔀 Перемешать" Command="{Binding ShuffleQuestions}" />
                  <MenuItem Header="⧉ Клонировать" Command="{Binding Clone}" />
                  <MenuItem Header="🗑 Удалить" Command="{Binding Remove}" />
                </ContextMenu>
              </StackPanel.ContextMenu>
            </StackPanel>
          </TreeDataTemplate>
          <DataTemplate DataType="vm:QuestionViewModel">
            <TextBlock Text="{Binding Model.Price}">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="⧉ Клонировать" Command="{Binding Clone}" />
                  <MenuItem Header="🗑 Удалить" Command="{Binding Remove}" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
      <GridSplitter Grid.Column="1" />
      <ScrollViewer Grid.Column="2">
        <StackPanel x:Name="Editor" Margin="16" Spacing="6" MaxWidth="900" HorizontalAlignment="Stretch" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
