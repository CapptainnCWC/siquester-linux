<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SIQuester.Avalonia.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemRegionColor">#262624</Color>
          <Color x:Key="SystemChromeLowColor">#262624</Color>
          <Color x:Key="SystemChromeMediumLowColor">#262624</Color>
          <Color x:Key="SystemChromeMediumColor">#30302E</Color>
          <Color x:Key="SystemChromeHighColor">#3A3A37</Color>
          <Color x:Key="SystemAltHighColor">#262624</Color>
          <Color x:Key="SystemBaseHighColor">#FAF9F5</Color>
          <Color x:Key="SystemAccentColor">#D97757</Color>
          <Color x:Key="SystemAccentColorLight1">#E08A6D</Color>
          <Color x:Key="SystemAccentColorDark1">#C4694B</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
